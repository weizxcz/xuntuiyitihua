    <mxCell id="ch" value="IM Channels（默认全关）&#10;飞书 / 钉钉 / 企微 / Slack / Discord / Telegram / WeChat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
