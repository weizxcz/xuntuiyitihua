    <!-- 记忆双层（短期 Checkpointer / 长期 Memory）-->
    <mxCell id="ckpt" value="短期记忆 Checkpointer&#10;(LangGraph 拥有 · thread级 · sqlite/PG)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="760" y="580" width="200" height="50" as="geometry" />
    </mxCell>
    <mxCell id="mem" value="长期记忆 Memory&#10;(per-user memory.json · user级 · 跨会话)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="760" y="640" width="200" height="50" as="geometry" />
    </mxCell>
    <mxCell id="note_mem" value="记忆双层（解耦）：&#10;• 短期 Checkpointer — LangGraph 框架层拥有，thread 级，存状态快照(对话历史/工具结果)，支持恢复/中断/human-in-loop；表由 LangGraph 管理，alembic 排除&#10;• 长期 Memory — DeerFlow 应用层，user 级；MemoryMiddleware 排队→后台 LLM 提炼 facts(置信度≥0.7)→原子写 memory.json；下次注入 system prompt 的 &lt;memory&gt; 标签" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9673a6;align=left;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="70" y="790" width="850" height="78" as="geometry" />
